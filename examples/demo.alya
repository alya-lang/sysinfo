## Example usage and walkthrough for sysinfo
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function main()
    say "=== sysinfo Package Showcase ==="
    say ""

    say "--- 1. Operating System ---"
    let os = pkg::os_info()
    say "Name:    " + os.name
    say "Version: " + os.version
    say "Arch:    " + os.arch
    say ""

    say "--- 2. CPU ---"
    let cpu = pkg::cpu_info()
    say "Arch:    " + cpu.arch
    say "Cores:   " + str(cpu.cores) + " logical / " + str(cpu.physical_cores) + " physical"
    say "Freq:    " + str(cpu.freq_mhz) + " MHz"
    say "Vendor:  " + cpu.vendor
    say "Model:   " + cpu.model
    say ""

    say "--- 3. Memory ---"
    let mem = pkg::mem_info()
    say "Total:   " + pkg::format_bytes(mem.total_bytes)
    say "Avail:   " + pkg::format_bytes(mem.avail_bytes)
    say "Summary: " + pkg::format_mem(mem)
    say "Swap:    " + pkg::format_swap(mem)
    say ""

    say "--- 4. Disk ---"
    let du = pkg::disk_usage()
    say "Path:    " + du.path + " [" + du.fstype + "]"
    say "Summary: " + pkg::format_disk(du)
    let vols = pkg::volumes()
    say "Mounts:  " + str(len(vols))
    if len(vols) > 0
        say "First:   " + pkg::format_disk(vols[0])
    end
    say ""

    say "--- 5. Host & Timezone ---"
    let host = pkg::host_info()
    say "Host:    " + host.hostname
    say "User:    " + host.username + " (elevated=" + str(pkg::elevated()) + ")"
    let tz = pkg::tz_info()
    say "TZ:      " + tz.name + " (" + pkg::format_utc_offset(tz.offset_min) + ")"
    say "Uptime:  " + pkg::format_duration(pkg::uptime_sec()) + " (boot " + str(pkg::boot_time()) + ")"
    say "Power:   " + pkg::format_power(pkg::power_info())
    say "Proc:    " + str(pkg::proc_pid()) + " " + pkg::exe_path()
    say "Env:     " + str(pkg::env_len()) + " vars"
    say ""

    say "--- 6. OS Detail ---"
    say "Kernel:  " + pkg::kernel()
    say "Distro:  " + pkg::distro_id() + " " + pkg::distro_version()
    say ""

    say "--- 7. Locale ---"
    say "Lang:    " + pkg::system_lang()
    let loc = pkg::locale_info()
    say "BCP47:   " + loc.bcp47 + " (lang=" + loc.lang + ", region=" + loc.region + ")"
    say ""

    say "--- 8. Full Snapshot ---"
    say pkg::summary()
    say ""
    say "--- 9. Detailed Report ---"
    say pkg::details()
    if pkg::load_is_known() == 1
        say "Load averages available on this platform"
    else
        say "Load averages unavailable on this platform"
    end
    say ""
    say "Done!"
end

main()
