## Benchmark suite for sysinfo
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("sysinfo Micro-Benchmarks")

    # Bench 1: system_info() aggregated snapshot — 1k iterations (FFI-heavy)
    bench_start(runner, 1000)
    let i = 0
    while i < 1000
        pkg::system_info()
        i += 1
    end
    bench_stop(runner, "system_info() 1k calls")

    # Bench 2: mem_info() — 10k iterations
    bench_start(runner, 10000)
    let j = 0
    while j < 10000
        pkg::mem_info()
        j += 1
    end
    bench_stop(runner, "mem_info() 10k calls")

    # Bench 3: normalize_locale() pure-Alya parsing — 100k iterations
    bench_start(runner, 100000)
    let k = 0
    while k < 100000
        pkg::normalize_locale("tr_TR.UTF-8")
        k += 1
    end
    bench_stop(runner, "normalize_locale() 100k calls")

    # Bench 4: format_bytes() — 100k iterations
    bench_start(runner, 100000)
    let m = 0
    while m < 100000
        pkg::format_bytes(17179869184)
        m += 1
    end
    bench_stop(runner, "format_bytes() 100k calls")

    # Bench 5: summary() full format pipeline — 1k iterations
    bench_start(runner, 1000)
    let s = 0
    while s < 1000
        pkg::summary()
        s += 1
    end
    bench_stop(runner, "summary() 1k calls")

    # Bench 6: mounts() volume enumeration — 1k iterations
    bench_start(runner, 1000)
    let v = 0
    while v < 1000
        pkg::volumes()
        v += 1
    end
    bench_stop(runner, "volumes() 1k calls")

    # Bench 7: env_all() environment parse — 1k iterations
    bench_start(runner, 1000)
    let e = 0
    while e < 1000
        pkg::env_map()
        e += 1
    end
    bench_stop(runner, "env_map() 1k calls")

    bench_summary(runner)
end

main()
