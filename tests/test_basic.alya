## Test suite for sysinfo
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    test_suite("sysinfo Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. OS identification
    # ═══════════════════════════════════════════════════════════
    let os_name = pkg::os_name()
    let known_os = os_name == "windows" or os_name == "linux" or os_name == "macos"
    runner_assert_true(r, known_os, "os_name is a known platform")
    runner_assert_true(r, len(pkg::os_version()) > 0, "os_version returns non-empty string")
    runner_assert_true(r, len(pkg::os_arch()) > 0, "os_arch returns non-empty string")

    let os = pkg::os_info()
    runner_assert_true(r, len(os.name) > 0, "os_info().name is non-empty")
    runner_assert_true(r, len(os.version) > 0, "os_info().version is non-empty")

    # ═══════════════════════════════════════════════════════════
    # 2. CPU
    # ═══════════════════════════════════════════════════════════
    runner_assert_true(r, pkg::cpu_cores() >= 1, "cpu_cores returns at least 1")
    runner_assert_true(r, len(pkg::cpu_arch()) > 0, "cpu_arch returns non-empty string")

    let cpu = pkg::cpu_info()
    runner_assert_true(r, cpu.cores >= 1, "cpu_info().cores >= 1")

    # ═══════════════════════════════════════════════════════════
    # 3. Memory
    # ═══════════════════════════════════════════════════════════
    let total = pkg::mem_total_bytes()
    let avail = pkg::mem_avail_bytes()
    runner_assert_true(r, total > 0, "mem_total_bytes returns positive value")
    runner_assert_true(r, avail >= 0, "mem_avail_bytes returns non-negative value")
    runner_assert_true(r, avail <= total, "available RAM does not exceed total RAM")

    let mem = pkg::mem_info()
    runner_assert_eq(r, mem.is_known(), 1, "mem_info is known")
    runner_assert_true(r, mem.total_mb() > 0, "total_mb is positive")
    runner_assert_true(r, mem.used_percent() >= 0, "used_percent is non-negative")
    runner_assert_true(r, mem.used_percent() <= 100, "used_percent does not exceed 100")

    # ═══════════════════════════════════════════════════════════
    # 4. Disk
    # ═══════════════════════════════════════════════════════════
    let du = pkg::disk_usage()
    runner_assert_eq(r, du.is_known(), 1, "disk_usage is known for default path")
    runner_assert_true(r, du.total_bytes > 0, "disk total is positive")
    runner_assert_true(r, du.free_bytes >= 0, "disk free is non-negative")
    runner_assert_true(r, du.free_bytes <= du.total_bytes, "disk free does not exceed total")
    runner_assert_true(r, du.used_percent() >= 0, "disk used_percent is non-negative")

    # ═══════════════════════════════════════════════════════════
    # 5. Host identity
    # ═══════════════════════════════════════════════════════════
    runner_assert_true(r, len(pkg::host_name()) > 0, "host_name returns non-empty string")
    let host = pkg::host_info()
    runner_assert_true(r, len(host.hostname) > 0, "host_info().hostname is non-empty")

    # ═══════════════════════════════════════════════════════════
    # 6. Timezone
    # ═══════════════════════════════════════════════════════════
    let tz = pkg::tz_info()
    runner_assert_true(r, tz.offset_min >= -720, "UTC offset is within -12h")
    runner_assert_true(r, tz.offset_min <= 840, "UTC offset is within +14h")
    runner_assert_str_eq(r, pkg::format_utc_offset(180), "UTC+3", "format_utc_offset(180) == UTC+3")
    runner_assert_str_eq(r, pkg::format_utc_offset(0), "UTC", "format_utc_offset(0) == UTC")

    # ═══════════════════════════════════════════════════════════
    # 7. Uptime
    # ═══════════════════════════════════════════════════════════
    runner_assert_true(r, pkg::uptime_sec() >= 0, "uptime_sec is non-negative")
    runner_assert_str_eq(r, pkg::format_duration(45), "45s", "format_duration seconds")
    runner_assert_str_eq(r, pkg::format_duration(150), "2m 30s", "format_duration minutes")
    runner_assert_str_eq(r, pkg::format_duration(9000), "2h 30m", "format_duration hours")

    # ═══════════════════════════════════════════════════════════
    # 8. Locale
    # ═══════════════════════════════════════════════════════════
    let loc = pkg::system_lang()
    runner_assert_true(r, len(loc) > 0, "system_lang returns non-empty tag")
    let chain = pkg::system_langs()
    runner_assert_true(r, len(chain) > 0, "system_langs returns fallback chain")
    runner_assert_str_eq(r, pkg::normalize_locale("tr_TR.UTF-8"), "tr-TR", "normalize tr_TR.UTF-8 to tr-TR")
    runner_assert_str_eq(r, pkg::normalize_locale("en-US"), "en-US", "normalize keeps en-US")
    runner_assert_str_eq(r, pkg::normalize_locale("en_US"), "en-US", "normalize en_US to en-US")
    runner_assert_str_eq(r, pkg::normalize_locale("tr:en"), "tr", "normalize takes first LANGUAGE entry")
    runner_assert_str_eq(r, pkg::normalize_locale("POSIX"), "", "normalize maps POSIX to empty")
    runner_assert_str_eq(r, pkg::normalize_locale("C"), "", "normalize maps C to empty")
    let fixed_loc = pkg::make_locale_info("tr-TR")
    runner_assert_str_eq(r, fixed_loc.bcp47, "tr-TR", "make_locale_info bcp47")
    runner_assert_str_eq(r, fixed_loc.lang, "tr", "make_locale_info lang")
    runner_assert_str_eq(r, fixed_loc.region, "TR", "make_locale_info region")
    let chain_last = chain[len(chain) - 1]
    runner_assert_str_eq(r, chain_last, "en", "fallback chain always ends with en")
    let info = pkg::locale_info()
    runner_assert_true(r, len(info.bcp47) > 0, "locale_info returns bcp47 tag")

    # ═══════════════════════════════════════════════════════════
    # 9. Formatters (deterministic vectors)
    # ═══════════════════════════════════════════════════════════
    runner_assert_str_eq(r, pkg::format_bytes(42), "42 B", "format_bytes bytes")
    runner_assert_str_eq(r, pkg::format_bytes(2048), "2 KB", "format_bytes kilobytes")
    runner_assert_str_eq(r, pkg::format_bytes(10485760), "10 MB", "format_bytes megabytes")
    runner_assert_str_eq(r, pkg::format_bytes(16106127360), "15 GB", "format_bytes gigabytes")
    runner_assert_str_eq(r, pkg::format_bytes(2199023255552), "2 TB", "format_bytes terabytes")
    runner_assert_str_eq(r, pkg::format_bytes(-1), "unknown", "format_bytes unknown")
    runner_assert_str_eq(r, pkg::format_duration(90000), "1d 1h", "format_duration days")
    runner_assert_str_eq(r, pkg::format_utc_offset(-300), "UTC-5", "format_utc_offset negative whole hour")
    runner_assert_str_eq(r, pkg::format_utc_offset(-330), "UTC-5:30", "format_utc_offset negative half hour")
    let fixed_mem = pkg::make_mem_info(2147483648, 1073741824, 1073741824, 536870912)
    runner_assert_str_eq(r, pkg::format_mem(fixed_mem), "RAM 1024/2048 MB (50%)", "format_mem fixed vector")
    runner_assert_str_eq(r, pkg::format_swap(fixed_mem), "Swap 512/1024 MB (50%)", "format_swap fixed vector")
    runner_assert_eq(r, fixed_mem.swap_mb(), 1024, "swap_mb fixed vector")

    # ═══════════════════════════════════════════════════════════
    # 10. Aggregated snapshot
    # ═══════════════════════════════════════════════════════════
    let sys = pkg::system_info()
    runner_assert_true(r, len(sys.os.version) > 0, "system_info().os.version is non-empty")
    runner_assert_true(r, sys.cpu.cores >= 1, "system_info().cpu.cores >= 1")
    runner_assert_true(r, sys.mem.total_bytes > 0, "system_info().mem.total_bytes is positive")
    runner_assert_true(r, len(pkg::summary()) > 0, "summary() returns non-empty string")
    runner_assert_true(r, len(pkg::details()) > 0, "details() returns non-empty string")

    # ═══════════════════════════════════════════════════════════
    # 11. OS detail (kernel, distro, privileges)
    # ═══════════════════════════════════════════════════════════
    runner_assert_true(r, len(pkg::kernel()) > 0, "kernel() returns non-empty release")
    let el = pkg::elevated()
    runner_assert_true(r, el == 0 or el == 1, "elevated() returns 0 or 1")
    let is_linux = pkg::os_name() == "linux"
    if is_linux
        runner_assert_true(r, len(pkg::distro_id()) > 0, "distro_id is non-empty on Linux")
    end

    # ═══════════════════════════════════════════════════════════
    # 12. CPU detail (physical cores, frequency, vendor)
    # ═══════════════════════════════════════════════════════════
    let phys = pkg::cpu_physical()
    runner_assert_true(r, phys >= 1, "cpu_physical returns at least 1")
    runner_assert_true(r, phys <= pkg::cpu_cores(), "physical cores do not exceed logical cores")
    runner_assert_true(r, pkg::cpu_freq_mhz() >= -1, "cpu_freq_mhz returns -1 or positive")
    runner_assert_true(r, len(pkg::format_cpu(pkg::cpu_info())) > 0, "format_cpu returns non-empty string")
    let os_flags = pkg::os_is_windows() + pkg::os_is_linux() + pkg::os_is_macos()
    runner_assert_eq(r, os_flags, 1, "exactly one OS flag is set")

    # ═══════════════════════════════════════════════════════════
    # 13. Swap memory
    # ═══════════════════════════════════════════════════════════
    let swap_total = pkg::swap_total()
    runner_assert_true(r, swap_total >= -1, "swap_total returns -1 or non-negative")
    let swap_pct = pkg::mem_info().swap_used_percent()
    runner_assert_true(r, swap_pct >= -1, "swap_used_percent returns -1 or non-negative")
    runner_assert_true(r, swap_pct <= 100, "swap_used_percent does not exceed 100")

    # ═══════════════════════════════════════════════════════════
    # 14. Filesystem type & mounted volumes
    # ═══════════════════════════════════════════════════════════
    let vols = pkg::volumes()
    runner_assert_true(r, len(vols) >= 1, "volumes() lists at least one mount")
    let first_vol: DiskUsage = vols[0]
    runner_assert_true(r, len(first_vol.path) > 0, "first volume has a mount path")
    runner_assert_true(r, first_vol.total_bytes > 0, "first volume total is positive")
    runner_assert_eq(r, pkg::mount_count(), len(vols), "mount_count matches volumes length")
    runner_assert_true(r, pkg::disk_usage("/no/such/path/xyz").is_known() == 0, "unknown path is not known")
    let not_macos = pkg::os_name() == "windows" or pkg::os_name() == "linux"
    if not_macos
        runner_assert_true(r, len(du.fstype) > 0, "fstype is known on Windows/Linux")
    end

    # ═══════════════════════════════════════════════════════════
    # 15. Power & battery
    # ═══════════════════════════════════════════════════════════
    let batt = pkg::battery()
    runner_assert_true(r, batt >= -1, "battery returns -1 or non-negative")
    runner_assert_true(r, batt <= 100, "battery does not exceed 100")
    let ac = pkg::on_ac()
    runner_assert_true(r, ac >= -1, "on_ac returns -1, 0 or 1")
    runner_assert_true(r, ac <= 1, "on_ac does not exceed 1")
    let pwr = pkg::power_info()
    runner_assert_true(r, pwr.has_battery() == 0 or pwr.has_battery() == 1, "has_battery returns 0 or 1")
    runner_assert_true(r, len(pkg::format_power(pwr)) > 0, "format_power returns non-empty string")

    # ═══════════════════════════════════════════════════════════
    # 16. Process, boot time & load average
    # ═══════════════════════════════════════════════════════════
    runner_assert_true(r, pkg::proc_pid() > 0, "proc_pid is positive")
    runner_assert_true(r, len(pkg::exe_path()) > 0, "exe_path returns non-empty string")
    runner_assert_true(r, pkg::boot_time() > 0, "boot_time returns positive Unix timestamp")
    let is_windows = pkg::os_name() == "windows"
    if is_windows
        runner_assert_true(r, pkg::load_avg_1() < 0.0, "load average is unavailable on Windows")
        runner_assert_true(r, pkg::load_avg_5() < 0.0, "load 5min is unavailable on Windows")
        runner_assert_true(r, pkg::load_avg_15() < 0.0, "load 15min is unavailable on Windows")
        runner_assert_eq(r, pkg::load_is_known(), 0, "load is not known on Windows")
    else
        runner_assert_true(r, pkg::load_avg_1() >= 0.0, "load_avg_1 is non-negative on POSIX")
        runner_assert_true(r, pkg::load_avg_5() >= 0.0, "load_avg_5 is non-negative on POSIX")
        runner_assert_true(r, pkg::load_avg_15() >= 0.0, "load_avg_15 is non-negative on POSIX")
    end
    runner_assert_true(r, pkg::uptime_days() >= 0, "uptime_days is non-negative")

    # ═══════════════════════════════════════════════════════════
    # 17. Full environment map
    # ═══════════════════════════════════════════════════════════
    runner_assert_true(r, pkg::env_len() > 0, "env_len returns positive count")
    let path_val = pkg::env_val("PATH", pkg::env_val("Path", ""))
    runner_assert_true(r, len(path_val) > 0, "PATH/Path is present in environment")
    runner_assert_str_eq(r, pkg::env_val("SYSINFO_DEFINITELY_MISSING_VAR", "fb"), "fb", "env_val falls back to default")

    # 18. Native C FFI verification
    let c_sum = pkg::c_add(10, 32)
    runner_assert_eq(r, c_sum, 42, "pkg::c_add executes bundled C code")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
