## # sysinfo/mem
##
## Physical memory reporting for Alya (byte counts, -1 when unavailable).
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./ffi.alya"

## Returns total physical RAM in bytes (-1 when unavailable).
pub function mem_total_bytes() -> int
    return sysinfo_mem_total()
end

## Returns available physical RAM in bytes (-1 when unavailable).
pub function mem_avail_bytes() -> int
    return sysinfo_mem_avail()
end

## Returns total swap/pagefile in bytes (-1 when unavailable).
pub function swap_total_bytes() -> int
    return sysinfo_swap_total()
end

## Returns available swap/pagefile in bytes (-1 when unavailable).
pub function swap_avail_bytes() -> int
    return sysinfo_swap_avail()
end

## Collects the current memory figures into a MemInfo record.
pub function mem_info() -> MemInfo
    return MemInfo {
        total_bytes: mem_total_bytes(),
        avail_bytes: mem_avail_bytes(),
        swap_total_bytes: swap_total_bytes(),
        swap_avail_bytes: swap_avail_bytes()
    }
end

## Builds a MemInfo record from explicit byte counts (useful for tests and demos).
pub function make_mem_info(total_bytes: int, avail_bytes: int, swap_total: int = -1, swap_avail: int = -1) -> MemInfo
    return MemInfo {
        total_bytes: total_bytes,
        avail_bytes: avail_bytes,
        swap_total_bytes: swap_total,
        swap_avail_bytes: swap_avail
    }
end
