## # sysinfo/timezone
##
## System timezone reporting for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "std/str"
import "./types.alya"
import "./ffi.alya"
import "./core/strutil.alya"

## Returns the system timezone name ("" when unavailable).
## Resolution: native OS API first, then TZ env. `name` keeps the OS-native
## namespace (Windows key names like "Turkey Standard Time", IANA names like
## "Europe/Istanbul" elsewhere) — never normalized; see tz_iana() for the mapping.
pub function tz_name() -> string
    let n = str_owned(sysinfo_tz_name())
    if len(n) > 0
        return n
    end
    return str_owned(get_env("TZ"))
end

## Returns the UTC offset in minutes (UTC+3 -> 180, -32768 when unknown).
## The native sentinel -32768 is propagated as-is (never coerced to 0/UTC);
## render it via format_utc_offset(), which prints "unknown".
pub function utc_offset_min() -> int
    return sysinfo_utc_offset_min()
end

## Maps an OS-native timezone name to IANA ("Turkey Standard Time" -> "Europe/Istanbul").
##
## Full Windows zone key table (CLDR windowsZones). Values already
## containing "/" pass through unchanged; unmappable names yield "".
## `name` itself is never normalized — the OS-native namespace is preserved.
##
## ### Parameters
## - `name`: OS-native timezone name.
##
## ### Returns
## IANA zone name, or "" when unmappable.
pub function tz_iana(name: string) -> string
    if name is null or len(name) == 0
        return ""
    end
    let table = _tz_windows_table()
    if name in table
        return table[name]
    end
    if index_of(name, "/") > 0
        return name
    end
    return ""
end

