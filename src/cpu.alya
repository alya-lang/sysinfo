## # sysinfo/cpu
##
## CPU identification for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./ffi.alya"

## Returns the canonical CPU arch id ("x64", "x86", "arm64").
pub function cpu_arch() -> string
    return target_arch()
end

## Returns the logical processor count (>= 1).
pub function cpu_cores() -> int
    let n = sysinfo_cpu_cores()
    if n > 0
        return n
    end
    return 1
end

## Returns the physical core count (>= 1, falls back to logical count).
pub function cpu_physical() -> int
    let n = sysinfo_cpu_physical()
    if n > 0
        return n
    end
    return cpu_cores()
end

## Returns the base CPU frequency in MHz (-1 when unavailable).
pub function cpu_freq_mhz() -> int
    return sysinfo_cpu_freq_mhz()
end

## Returns the human-readable CPU model ("" when unavailable).
pub function cpu_model() -> string
    return sysinfo_cpu_model()
end

## Returns the CPU vendor ("GenuineIntel", "AuthenticAMD", "Apple", "" when unavailable).
pub function cpu_vendor() -> string
    return sysinfo_cpu_vendor()
end

## Collects the current CPU details into a CpuInfo record.
pub function cpu_info() -> CpuInfo
    return CpuInfo {
        arch: cpu_arch(),
        cores: cpu_cores(),
        physical_cores: cpu_physical(),
        freq_mhz: cpu_freq_mhz(),
        model: cpu_model(),
        vendor: cpu_vendor()
    }
end
