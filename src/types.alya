## sysinfo Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Canonical domain models for cross-platform system information.

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## Operating system details.
##
## ### Fields
## - `name`: Canonical OS id (`"windows"`, `"linux"`, `"macos"`).
## - `version`: Human-readable version (`"Windows 11 (10.0.26100)"`, `"Ubuntu 24.04.1 LTS"`).
## - `arch`: Canonical CPU arch id (`"x64"`, `"x86"`, `"arm64"`).
## - `kernel`: Kernel release (`"NT 10.0.26200"`, `"24.6.0"`, `"6.8.0-52-generic"`).
## - `distro_id`: Distribution id from `/etc/os-release` (`"ubuntu"`, "" elsewhere).
## - `distro_version`: Distribution version (`"24.04"`, "" elsewhere).
pub struct OsInfo
    name: string,
    version: string,
    arch: string,
    kernel: string,
    distro_id: string,
    distro_version: string
end

## CPU details.
##
## ### Fields
## - `arch`: Canonical CPU arch id.
## - `cores`: Logical processor count (-1 when unknown).
## - `physical_cores`: Physical core count (>= 1, -1 when unavailable).
## - `freq_mhz`: Base frequency in MHz (-1 when unavailable).
## - `model`: Human-readable CPU model ("" when unavailable).
## - `vendor`: CPU vendor (`"GenuineIntel"`, `"AuthenticAMD"`, `"Apple"`, "" when unavailable).
pub struct CpuInfo
    arch: string,
    cores: int,
    physical_cores: int,
    freq_mhz: int,
    model: string,
    vendor: string
end

## Memory details (byte counts, -1 when unavailable).
##
## ### Fields
## - `total_bytes`: Total physical RAM in bytes.
## - `avail_bytes`: Available physical RAM in bytes.
## - `swap_total_bytes`: Total swap/pagefile in bytes.
## - `swap_avail_bytes`: Available swap/pagefile in bytes.
## - `estimated`: 1 when figures are estimated, 0 when exact (from sysinfo_mem_estimated()).
##
## Swap semantics per OS: Windows reports pagefile arithmetic (total vs available
## pagefile), Linux reports SwapTotal/SwapFree from /proc/meminfo, macOS reports
## swap usage (used swap file size).
pub struct MemInfo
    total_bytes: int,
    avail_bytes: int,
    swap_total_bytes: int,
    swap_avail_bytes: int,
    estimated: int
end

## Disk usage for a single path (byte counts, -1 when unavailable).
##
## ### Fields
## - `path`: Queried mount path (`"C:/"`, `"/"`; UNC paths kept verbatim on Windows).
## - `fstype`: Filesystem type (`"NTFS"`, `"ext4"`, "" when unavailable).
## - `total_bytes`: Filesystem total size in bytes.
## - `free_bytes`: Filesystem available size in bytes (quota-aware available space:
##   free-for-caller on Windows, `f_bavail` elsewhere — never raw `f_bfree`).
##   `used_percent()` derives from this free-vs-avail figure.
pub struct DiskUsage
    path: string,
    fstype: string,
    total_bytes: int,
    free_bytes: int
end

## Host identity.
##
## ### Fields
## - `hostname`: Machine hostname ("" when unavailable).
## - `username`: Current user name ("" when unavailable).
pub struct HostInfo
    hostname: string,
    username: string
end

## Timezone details.
##
## ### Fields
## - `name`: System timezone name in the OS-native namespace (`"Turkey Standard Time"`
##   on Windows, `"Europe/Istanbul"` elsewhere — never normalized).
## - `offset_min`: UTC offset in minutes (UTC+3 -> 180, -32768 when unknown).
## - `iana`: IANA-mapped zone name (`"Europe/Istanbul"`, "" when unmappable).
pub struct TzInfo
    name: string,
    offset_min: int,
    iana: string
end

## Power details (-1 when unavailable, e.g. desktops without battery).
##
## ### Fields
## - `battery_percent`: Battery charge 0-100.
## - `on_ac`: 1 on AC power, 0 discharging.
pub struct PowerInfo
    battery_percent: int,
    on_ac: int
end

## Network interface details ("" when a datum is unavailable).
##
## ### Fields
## - `name`: Interface name (`"Ethernet"`, `"eth0"`, `"en0"`).
## - `mac`: Lowercase colon-separated MAC (`"aa:bb:cc:dd:ee:ff"`).
## - `ipv4`: First IPv4 address dotted (`"192.168.1.2"`).
## - `ipv6`: First IPv6 address, scope-stripped, no brackets.
## - `is_up`: 1 when the interface is administratively up.
## - `is_loopback`: 1 for loopback interfaces.
pub struct NetInterface
    name: string,
    mac: string,
    ipv4: string,
    ipv6: string,
    is_up: int,
    is_loopback: int
end

## Per-interface throughput over one sampling window.
##
## ### Fields
## - `name`: Interface name matching `NetInterface.name`.
## - `rx_bps`: Download bytes/sec (-1 when unmeasurable).
## - `tx_bps`: Upload bytes/sec (-1 when unmeasurable).
pub struct NetRate
    name: string,
    rx_bps: int,
    tx_bps: int
end

## Current process details.
##
## ### Fields
## - `pid`: Current process id.
## - `exe`: Current executable path ("" when unavailable).
##
## Exe-path semantics per OS: Windows reports the UTF-8 module path,
## Linux reads /proc/self/exe (capped at 2047 chars + NUL), macOS may return
## an unresolved path when the executable was renamed or deleted.
pub struct ProcInfo
    pid: int,
    exe: string
end

## System locale record.
##
## ### Fields
## - `bcp47`: Full tag (`"tr-TR"`).
## - `lang`: Base language (`"tr"`; `"C"` for the C/POSIX locale, never `"en"`).
## - `region`: Region part (`"TR"`, "" when absent).
##
## `"C"`/`"POSIX"` are preserved distinctly and never normalized to `"en"`.
pub struct LocaleInfo
    bcp47: string,
    lang: string,
    region: string
end

## Aggregated system snapshot.
##
## ### Fields
## - `os`: Operating system details.
## - `cpu`: CPU details.
## - `mem`: Memory details.
## - `disk`: Disk usage for the default path.
## - `host`: Host identity.
## - `tz`: Timezone details.
## - `power`: Power details.
## - `proc`: Current process details.
## - `uptime_sec`: Seconds since boot (-1 when unavailable).
## - `locale`: Best system locale tag.
pub struct SystemInfo
    os: OsInfo,
    cpu: CpuInfo,
    mem: MemInfo,
    disk: DiskUsage,
    host: HostInfo,
    tz: TzInfo,
    power: PowerInfo,
    proc: ProcInfo,
    uptime_sec: int,
    locale: string,
    net: array
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: MemInfo
# ───────────────────────────────────────────────────────────────

## Returns total RAM in whole megabytes (-1 when unavailable).
pub function MemInfo.total_mb(self: MemInfo) -> int
    if self.total_bytes < 0
        return -1
    end
    return self.total_bytes / 1048576
end

## Returns available RAM in whole megabytes (-1 when unavailable).
pub function MemInfo.avail_mb(self: MemInfo) -> int
    if self.avail_bytes < 0
        return -1
    end
    return self.avail_bytes / 1048576
end

## Returns used RAM percentage 0-100 (-1 when unavailable).
pub function MemInfo.used_percent(self: MemInfo) -> int
    if self.total_bytes <= 0 or self.avail_bytes < 0
        return -1
    end
    let used = self.total_bytes - self.avail_bytes
    if used < 0
        return 0
    end
    if used > self.total_bytes
        return 100
    end
    return (used * 100) / self.total_bytes
end

## Returns 1 when total RAM is known, 0 otherwise.
pub function MemInfo.is_known(self: MemInfo) -> int
    if self.total_bytes > 0
        return 1
    end
    return 0
end

## Returns swap total in whole megabytes (-1 when unavailable).
pub function MemInfo.swap_mb(self: MemInfo) -> int
    if self.swap_total_bytes < 0
        return -1
    end
    return self.swap_total_bytes / 1048576
end

## Returns used swap percentage 0-100 (-1 when unavailable).
pub function MemInfo.swap_used_percent(self: MemInfo) -> int
    if self.swap_total_bytes <= 0 or self.swap_avail_bytes < 0
        return -1
    end
    let used = self.swap_total_bytes - self.swap_avail_bytes
    if used < 0
        return 0
    end
    if used > self.swap_total_bytes
        return 100
    end
    return (used * 100) / self.swap_total_bytes
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: DiskUsage
# ───────────────────────────────────────────────────────────────

## Returns used bytes (total - free), or -1 when unavailable.
pub function DiskUsage.used_bytes(self: DiskUsage) -> int
    if self.total_bytes < 0 or self.free_bytes < 0
        return -1
    end
    return self.total_bytes - self.free_bytes
end

## Returns used disk percentage 0-100 (-1 when unavailable).
pub function DiskUsage.used_percent(self: DiskUsage) -> int
    if self.total_bytes <= 0 or self.free_bytes < 0
        return -1
    end
    let used = self.total_bytes - self.free_bytes
    if used < 0
        return 0
    end
    if used > self.total_bytes
        return 100
    end
    return (used * 100) / self.total_bytes
end

## Returns 1 when disk figures are known, 0 otherwise.
pub function DiskUsage.is_known(self: DiskUsage) -> int
    if self.total_bytes > 0
        return 1
    end
    return 0
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: PowerInfo
# ───────────────────────────────────────────────────────────────

## Returns 1 when a battery is present, 0 otherwise.
pub function PowerInfo.has_battery(self: PowerInfo) -> int
    if self.battery_percent >= 0
        return 1
    end
    return 0
end

## Returns 1 when on AC power, 0 otherwise (unknown counts as 0).
pub function PowerInfo.is_on_ac(self: PowerInfo) -> int
    if self.on_ac == 1
        return 1
    end
    return 0
end
