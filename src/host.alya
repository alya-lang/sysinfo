## # sysinfo/host
##
## Host identity for Alya (native API first, env fallback).
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./ffi.alya"
import "./core/strutil.alya"

## Returns the machine hostname ("" when unavailable).
## Resolution order: native sysinfo_host_native() -> legacy sysinfo_host_name() ->
## COMPUTERNAME env (Windows only) -> HOSTNAME env.
pub function host_name() -> string
    let n = str_owned(sysinfo_host_native())
    if len(n) > 0
        return n
    end
    let legacy = str_owned(sysinfo_host_name())
    if len(legacy) > 0
        return legacy
    end
    if target_os() == "windows"
        let c = str_owned(get_env("COMPUTERNAME"))
        if len(c) > 0
            return c
        end
    end
    return str_owned(get_env("HOSTNAME"))
end

## Returns the current user name ("" when unavailable).
## Resolution order: native sysinfo_user_name() -> USERNAME -> USER -> LOGNAME env.
pub function host_user() -> string
    let n = str_owned(sysinfo_user_name())
    if len(n) > 0
        return n
    end
    let a = str_owned(get_env("USERNAME"))
    if len(a) > 0
        return a
    end
    let u = str_owned(get_env("USER"))
    if len(u) > 0
        return u
    end
    return str_owned(get_env("LOGNAME"))
end

## Collects host identity into a HostInfo record.
pub function host_info() -> HostInfo
    return HostInfo {
        hostname: host_name(),
        username: host_user()
    }
end
