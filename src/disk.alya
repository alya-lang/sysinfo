## # sysinfo/disk
##
## Disk usage reporting for Alya (byte counts, -1 when unavailable).
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "std/str"
import "std/path"
import "./types.alya"
import "./ffi.alya"
import "./core/strutil.alya"

## Returns the default query path ("C:/" on Windows, "/" elsewhere).
pub function disk_default_path() -> string
    return when target_os()
        is "windows" => "C:/"
        else => "/"
    end
end

## Resolves a caller path for native queries: UNC ("\\\\server\\share") and
## extended-length ("\\\\?\\") Windows paths pass through verbatim (slash
## conversion would corrupt them); everything else is slash-normalized.
pub function disk_query_path(path: string) -> string
    if len(path) >= 4 and path[..4] == "\\\\?\\"
        return path
    end
    if len(path) >= 2 and path[..2] == "\\\\"
        return path
    end
    return to_slash(path)
end

## Returns filesystem total size in bytes for path (-1 when unavailable).
pub function disk_total_bytes(path: string = "") -> int
    let p = disk_query_path(path)
    if len(p) == 0
        p = disk_default_path()
    end
    return sysinfo_disk_total(p)
end

## Returns filesystem available size in bytes for path (-1 when unavailable; quota-aware avail).
pub function disk_free_bytes(path: string = "") -> int
    let p = disk_query_path(path)
    if len(p) == 0
        p = disk_default_path()
    end
    return sysinfo_disk_free(p)
end

## Returns the filesystem type for path ("NTFS", "ext4", "" when unavailable).
pub function fs_type(path: string = "") -> string
    let p = disk_query_path(path)
    if len(p) == 0
        p = disk_default_path()
    end
    return str_owned(sysinfo_fs_type(p))
end

## Collects disk usage for path into a DiskUsage record.
## `free_bytes` is quota-aware available space (see DiskUsage docs).
pub function disk_usage(path: string = "") -> DiskUsage
    let p = disk_query_path(path)
    if len(p) == 0
        p = disk_default_path()
    end
    return DiskUsage {
        path: p,
        fstype: str_owned(sysinfo_fs_type(p)),
        total_bytes: sysinfo_disk_total(p),
        free_bytes: sysinfo_disk_free(p)
    }
end

## Returns the number of mounted volumes.
pub function mount_count() -> int
    let n = sysinfo_mount_count()
    if n < 0
        return 0
    end
    return n
end

## Returns usage records for every mounted volume.
## Tolerates native index skew: empty entries or ones lacking the "|" separator
## (holes from concurrent unmounts) are skipped, so output length may be < mount_count().
pub function mounts() -> array
    let out = []
    let n = mount_count()
    let i = 0
    while i < n
        let entry = str_owned(sysinfo_mount_at(i))
        let sep = index_of(entry, "|")
        if sep > 0
            let mnt = str_owned(disk_query_path(entry[..sep]))
            let fst = str_owned(entry[(sep + 1)..])
            out.push(DiskUsage {
                path: mnt,
                fstype: fst,
                total_bytes: sysinfo_disk_total(mnt),
                free_bytes: sysinfo_disk_free(mnt)
            })
        end
        i += 1
    end
    return out
end
