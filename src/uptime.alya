## # sysinfo/uptime
##
## System uptime reporting for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./ffi.alya"

## Returns seconds since boot (-1 when unavailable; never coerced to 0).
pub function uptime_sec() -> int
    return sysinfo_uptime_sec()
end

## Returns whole minutes since boot (-1 when unavailable).
pub function uptime_min() -> int
    let s = uptime_sec()
    if s < 0
        return -1
    end
    return s / 60
end

## Returns whole hours since boot (-1 when unavailable).
pub function uptime_hours() -> int
    let s = uptime_sec()
    if s < 0
        return -1
    end
    return s / 3600
end

## Returns whole days since boot (-1 when unavailable).
pub function uptime_days() -> int
    let s = uptime_sec()
    if s < 0
        return -1
    end
    return s / 86400
end

## Returns the Unix timestamp of the last boot (-1 when unavailable).
pub function boot_unix() -> int
    return sysinfo_boot_unix()
end
