    function sysinfo_cpu_freq_mhz() -> i64
    function sysinfo_cpu_vendor() -> str
    function sysinfo_swap_total() -> i64
    function sysinfo_swap_avail() -> i64
    function sysinfo_battery_percent() -> i32
    function sysinfo_on_ac() -> i32
    function sysinfo_exe_path() -> str
