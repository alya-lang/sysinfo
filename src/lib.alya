## sysinfo Library Facade
##
## Cross-platform system information for Alya: OS, CPU, memory, disk,
## host, timezone, uptime, and locale.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./ffi.alya"
import "./locale.alya"
import "./os_info.alya"
import "./cpu.alya"
import "./mem.alya"
import "./disk.alya"
import "./host.alya"
import "./timezone.alya"
import "./uptime.alya"
import "./core/formatter.alya"

# ───────────────────────────────────────────────────────────────
# Aggregated Snapshot
# ───────────────────────────────────────────────────────────────

## Collects a full system snapshot into a SystemInfo record.
##
## ### Returns
## Populated `SystemInfo` with OS, CPU, memory, disk, host, timezone,
## uptime, and locale details.
##
## ### Examples
## ```alya
## let info = system_info()
## say info.os.version
## ```
pub function system_info() -> SystemInfo
    return SystemInfo {
        os: os_info(),
        cpu: cpu_info(),
        mem: mem_info(),
        disk: disk_usage(),
        host: host_info(),
        tz: tz_info(),
        uptime_sec: uptime_sec(),
        locale: system_locale_tag()
    }
end

## Returns a one-line human-readable system summary.
##
## ### Returns
## Formatted snapshot string (OS, CPU, RAM, disk, host, TZ, uptime, locale).
pub function summary() -> string
    return format_system_summary(system_info())
end

# ───────────────────────────────────────────────────────────────
# System Locale Facade (native API + env fallback, see locale.alya)
# ───────────────────────────────────────────────────────────────

## Returns the best system locale tag (e.g. "tr-TR", "en-US"), "en" fallback.
pub function system_lang(default_lang: string = "en") -> string
    return system_locale_tag(default_lang)
end

## Returns the locale fallback chain (e.g. ["tr-TR", "tr", "en"]).
pub function system_langs() -> array
    return system_locale_chain()
end

## Normalizes a raw locale string to BCP-47-ish form ("tr_TR.UTF-8" -> "tr-TR").
pub function normalize_locale(raw) -> string
    return normalize_locale_tag(raw)
end

## Returns LocaleInfo for the current system locale.
pub function locale_info() -> LocaleInfo
    return system_locale_info()
end

# ───────────────────────────────────────────────────────────────
# Native C FFI helper (bundled engine smoke test)
# ───────────────────────────────────────────────────────────────

## Native C FFI helper function
pub function c_add(a: int = 0, b: int = 0) -> int
    return alya_sysinfo_add(a, b)
end
