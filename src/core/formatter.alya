## sysinfo Core Formatting Engine
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Human-readable formatters for byte counts, durations, and system snapshots.

import "../types.alya"

## Formats a byte count with one decimal ("2 TB", "15.9 GB", "5.2 GB", "512 MB", "1.5 KB", "42 B") ("unknown" when negative).
## Small exact values stay in bytes ("0 B", "42 B"); KB and up carry one decimal unless exact.
pub function format_bytes(n: int) -> string
    if n < 0
        return "unknown"
    end
    if n >= 1099511627776
        let tenths = (n * 10 + 549755813888) / 1099511627776
        let whole = tenths / 10
        let frac = tenths - whole * 10
        if frac == 0
            return "{whole} TB"
        end
        return "{whole}.{frac} TB"
    end
    if n >= 1073741824
        let tenths = (n * 10 + 536870912) / 1073741824
        let whole = tenths / 10
        let frac = tenths - whole * 10
        if frac == 0
            return "{whole} GB"
        end
        return "{whole}.{frac} GB"
    end
    if n >= 1048576
        let tenths = (n * 10 + 524288) / 1048576
        let whole = tenths / 10
        let frac = tenths - whole * 10
        if frac == 0
            return "{whole} MB"
        end
        return "{whole}.{frac} MB"
    end
    if n >= 1024
        let tenths = (n * 10 + 512) / 1024
        let whole = tenths / 10
        let frac = tenths - whole * 10
        if frac == 0
            return "{whole} KB"
        end
        return "{whole}.{frac} KB"
    end
    return "{n} B"
end

## Formats seconds as "3d 1h 12m", "3d 4h", "5h 12m", "7m 30s", "45s" ("unknown" when negative).
## Minutes are included whenever a nonzero minute remainder exists, even with days/hours present.
pub function format_duration(total_sec: int) -> string
    if total_sec < 0
        return "unknown"
    end
    let d = total_sec / 86400
    let rest_d = total_sec - d * 86400
    let h = rest_d / 3600
    let rest_h = rest_d - h * 3600
    let m = rest_h / 60
    let s = rest_h - m * 60
    if d > 0
        if m > 0
            return "{d}d {h}h {m}m"
        end
        return "{d}d {h}h"
    end
    if h > 0
        return "{h}h {m}m"
    end
    if m > 0
        return "{m}m {s}s"
    end
    return "{s}s"
end

## Pads an integer to two digits ("7" -> "07").
function two_digits(v: int) -> string
    if v < 10
        return "0{str(v)}"
    end
    return str(v)
end

## Formats a Unix timestamp as "YYYY-MM-DD HH:MM UTC" ("unknown" when negative).
## Pure civil-date arithmetic, no OS dependency, so boot times render identically on every platform.
pub function format_unix_date(ts: int) -> string
    if ts < 0
        return "unknown"
    end
    let days = ts / 86400
    let secs = ts - days * 86400
    let hh = secs / 3600
    let mm = (secs - hh * 3600) / 60
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if m > 12
        m = m - 12
        y = y + 1
    end
    return "{y}-{two_digits(m)}-{two_digits(d)} {two_digits(hh)}:{two_digits(mm)} UTC"
end

## Formats a UTC offset in minutes as "UTC+3", "UTC-5:30", "UTC" ("unknown" for -32768).
## The -32768 sentinel (unknown) never renders as "UTC".
pub function format_utc_offset(offset_min: int) -> string    if offset_min == -32768
        return "unknown"
    end
    if offset_min == 0
        return "UTC"
    end
    let sign = "+"
    let mag = offset_min
    if offset_min < 0
        sign = "-"
        mag = 0 - offset_min
    end
    let h = mag / 60
    let rest = mag - h * 60
    if rest == 0
        return "UTC{sign}{h}"
    end
    return "UTC{sign}{h}:{rest}"
end

## Formats a one-line memory overview ("RAM 15956/32686 MB (48%)"; "~" prefix when estimated).
pub function format_mem(info: MemInfo) -> string
    if info.is_known() == 0
        return "RAM unknown"
    end
    let mark = ""
    if info.estimated == 1
        mark = "~"
    end
    let total = info.total_mb()
    if info.avail_mb() < 0
        return "{mark}RAM {total} MB"
    end
    let avail = info.avail_mb()
    let used = total - avail
    let pct = info.used_percent()
    return "{mark}RAM {used}/{total} MB ({pct}%)"
end

## Formats a swap overview ("Swap 512/1024 MB (50%)", "Swap none", "Swap unknown"; "~" prefix when estimated).
pub function format_swap(info: MemInfo) -> string
    if info.swap_total_bytes < 0
        return "Swap unknown"
    end
    if info.swap_total_bytes == 0
        return "Swap none"
    end
    let mark = ""
    if info.estimated == 1
        mark = "~"
    end
    let total = info.swap_mb()
    if info.swap_avail_bytes < 0
        return "{mark}Swap {total} MB"
    end
    let avail = info.swap_avail_bytes / 1048576
    let used = total - avail
    let pct = info.swap_used_percent()
    return "{mark}Swap {used}/{total} MB ({pct}%)"
end

## Formats a one-line disk overview ("C:/ 120/256 GB (47%)").
## Percent derives from the documented free-vs-avail figure (quota-aware avail).
pub function format_disk(usage: DiskUsage) -> string
    if usage.is_known() == 0
        return "{usage.path} unknown"
    end
    let total_g = usage.total_bytes / 1073741824
    let used_g = usage.used_bytes() / 1073741824
    let pct = usage.used_percent()
    if len(usage.fstype) > 0
        return "{usage.path} [{usage.fstype}] {used_g}/{total_g} GB ({pct}%)"
    end
    return "{usage.path} {used_g}/{total_g} GB ({pct}%)"
end

## Formats power status ("Battery 87% (AC)", "AC power", "Power unknown").
pub function format_power(info: PowerInfo) -> string
    if info.has_battery() == 1
        let pct = info.battery_percent
        if info.on_ac == 1
            return "Battery {pct}% (AC)"
        end
        if info.on_ac == 0
            return "Battery {pct}% (discharging)"
        end
        return "Battery {pct}% (power source unknown)"
    end
    if info.is_on_ac() == 1
        return "AC power"
    end
    return "Power unknown"
end

## Formats CPU details ("Intel64 ... x8/16, 2394 MHz"; "?" for unknown counts, -1 = unknown).
pub function format_cpu(info: CpuInfo) -> string
    let cores = "?"
    if info.cores > 0
        cores = "{info.cores}"
    end
    if info.physical_cores > 0 and info.physical_cores != info.cores
        if info.cores > 0
            cores = "{info.physical_cores}/{info.cores}"
        else
            cores = "{info.physical_cores}/?"
        end
    end
    if info.freq_mhz > 0
        return "{info.model} x{cores}, {info.freq_mhz} MHz"
    end
    return "{info.model} x{cores}"
end

## Formats a full multi-line system snapshot.
pub function format_system_summary(info: SystemInfo) -> string
    let mem = format_mem(info.mem)
    let disk = format_disk(info.disk)
    let up = format_duration(info.uptime_sec)
    let off = format_utc_offset(info.tz.offset_min)
    let cpu = format_cpu(info.cpu)
    let power = format_power(info.power)
    return "OS: {info.os.version} [{info.os.arch}] | CPU: {cpu} | {mem} | Disk: {disk} | Host: {info.host.hostname} | TZ: {info.tz.name} ({off}) | {power} | Uptime: {up} | Locale: {info.locale}"
end

## Formats a detailed multi-line system report (one section per line).
pub function format_system_details(info: SystemInfo) -> string
    let s = "OS:      {info.os.version} [{info.os.arch}] (kernel {info.os.kernel})"
    s = s + "\nCPU:     {format_cpu(info.cpu)}"
    s = s + "\nMemory:  {format_mem(info.mem)}"
    s = s + "\nDisk:    {format_disk(info.disk)}"
    s = s + "\nHost:    {info.host.hostname} (user {info.host.username})"
    s = s + "\nTime:    {info.tz.name} ({format_utc_offset(info.tz.offset_min)}), up {format_duration(info.uptime_sec)}"
    s = s + "\nPower:   {format_power(info.power)}"
    s = s + "\nProc:    {info.proc.pid} {info.proc.exe}"
    s = s + "\nLocale:  {info.locale}"
    return s
end
