## # sysinfo/net
##
## Network interface enumeration for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./ffi.alya"
import "./core/strutil.alya"
import "std/time" as time

## Returns the number of enumerated network interfaces (-1 on failure).
pub function net_count() -> int
    return sysinfo_net_count()
end

## Parses one "name|mac|ipv4|ipv6|up|loopback" native entry.
function parse_net_entry(entry: string) -> NetInterface
    let parts = split(entry, "|")
    let name = ""
    let mac = ""
    let ipv4 = ""
    let ipv6 = ""
    let up = 0
    let loop = 0
    if len(parts) > 0
        name = parts[0]
    end
    if len(parts) > 1
        mac = parts[1]
    end
    if len(parts) > 2
        ipv4 = parts[2]
    end
    if len(parts) > 3
        ipv6 = parts[3]
    end
    if len(parts) > 4 and parts[4] == "1"
        up = 1
    end
    if len(parts) > 5 and parts[5] == "1"
        loop = 1
    end
    return NetInterface {
        name: name,
        mac: mac,
        ipv4: ipv4,
        ipv6: ipv6,
        is_up: up,
        is_loopback: loop
    }
end

## Returns interface records for every enumerated adapter.
##
## Tolerates native index skew like mounts(): entries that fail to parse
## are skipped, so output length may be < net_count().
pub function net_interfaces() -> array
    let out = []
    let n = net_count()
    if n < 0
        return out
    end
    let i = 0
    while i < n
        let entry = str_owned(sysinfo_net_at(i))
        if len(entry) > 0
            let nic = parse_net_entry(entry)
            if len(nic.name) > 0
                out.push(nic)
            end
        end
        i += 1
    end
    return out
end

## Returns the loopback interface record, or null when absent.
pub function net_loopback()
    let nics = net_interfaces()
    let i = 0
    while i < len(nics)
        let nic: NetInterface = nics[i]
        if nic.is_loopback == 1
            return nic
        end
        i += 1
    end
    return null
end

## Parses one "name|rx|tx" snapshot line into name + counters.
## Returns an empty map when the line is malformed.
function parse_counter_line(line: string) -> map
    let bad = { "name": "", "rx": -1, "tx": -1 }
    let parts = split(line, "|")
    if len(parts) != 3 or len(parts[0]) == 0
        return bad
    end
    return { "name": parts[0], "rx": to_int(parts[1]), "tx": to_int(parts[2]) }
end

## Takes one octet-counter snapshot keyed by interface name.
function snap_counters() -> map
    let snap = {}
    let raw = str_owned(sysinfo_net_counters_all())
    if len(raw) == 0
        return snap
    end
    let lines = split(raw, "\n")
    let i = 0
    while i < len(lines)
        let e = parse_counter_line(trim(lines[i]))
        if len(e["name"]) > 0 and e["rx"] >= 0 and e["tx"] >= 0
            snap[e["name"]] = [e["rx"], e["tx"]]
        end
        i += 1
    end
    return snap
end

## Measures per-interface throughput over one interval.
##
## Samples cumulative octet counters, waits `interval_ms`, samples again,
## and reports bytes/sec per interface present in both snapshots. Counter
## resets/wraps clamp to 0 for that interval. Elapsed time is measured
## (not assumed) so slow timers don't skew the rate.
##
## ### Parameters
## - `interval_ms`: Sampling window in milliseconds (default 1000).
##
## ### Returns
## Array of `NetRate` records (possibly empty on failure).
pub function net_rates(interval_ms: int = 1000) -> array
    let out = []
    let wait = interval_ms
    if wait < 50
        wait = 50
    end
    let a = snap_counters()
    let t0 = time::now_ms()
    time::delay(wait)
    let elapsed = time::now_ms() - t0
    if elapsed <= 0
        elapsed = wait
    end
    let b = snap_counters()
    let names = a.keys()
    let i = 0
    while i < len(names)
        let nm = names[i]
        if has(b, nm)
            let pa = a[nm]
            let pb = b[nm]
            let drx = pb[0] - pa[0]
            let dtx = pb[1] - pa[1]
            if drx < 0
                drx = 0
            end
            if dtx < 0
                dtx = 0
            end
            out.push(NetRate {
                name: nm,
                rx_bps: drx * 1000 / elapsed,
                tx_bps: dtx * 1000 / elapsed
            })
        end
        i += 1
    end
    return out
end

## Measures throughput for one interface (bytes/sec, -1 rates on failure).
pub function net_rate(name: string, interval_ms: int = 1000) -> NetRate
    let rates = net_rates(interval_ms)
    let i = 0
    while i < len(rates)
        let r: NetRate = rates[i]
        if r.name == name
            return r
        end
        i += 1
    end
    return NetRate { name: name, rx_bps: -1, tx_bps: -1 }
end
