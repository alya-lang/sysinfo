## # sysinfo/os_info
##
## Operating system identification for Alya.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "./types.alya"
import "./ffi.alya"
import "./core/strutil.alya"

## Returns the canonical OS id ("windows", "linux", "macos").
pub function os_name() -> string
    return target_os()
end

## Returns the human-readable OS version, falling back to the OS id.
pub function os_version() -> string
    let v = sysinfo_os_version()
    if len(v) > 0
        return str_owned(v)
    end
    return target_os()
end

## Returns the canonical CPU arch id ("x64", "x86", "arm64").
pub function os_arch() -> string
    return target_arch()
end

## Returns the kernel release ("NT 10.0.26200", "24.6.0", "6.8.0-52-generic").
pub function kernel_version() -> string
    return str_owned(sysinfo_kernel_version())
end

## Returns the distribution id ("ubuntu", "debian", "" on Windows/macOS).
pub function distro_id() -> string
    return str_owned(sysinfo_distro_id())
end

## Returns the distribution version ("24.04", "" on Windows/macOS).
pub function distro_version() -> string
    return str_owned(sysinfo_distro_version())
end

## Returns 1 when running with elevated privileges (admin/root), else 0.
pub function is_elevated() -> int
    return sysinfo_is_elevated()
end

## Returns 1 on Windows, else 0.
pub function os_is_windows() -> int
    if target_os() == "windows"
        return 1
    end
    return 0
end

## Returns 1 on Linux, else 0.
pub function os_is_linux() -> int
    if target_os() == "linux"
        return 1
    end
    return 0
end

## Returns 1 on macOS, else 0.
pub function os_is_macos() -> int
    if target_os() == "macos"
        return 1
    end
    return 0
end

## Collects the current OS details into an OsInfo record.
pub function os_info() -> OsInfo
    return OsInfo {
        name: os_name(),
        version: os_version(),
        arch: os_arch(),
        kernel: kernel_version(),
        distro_id: distro_id(),
        distro_version: distro_version()
    }
end
